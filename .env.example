# ---- Required ----
# Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace-me
# Key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-replace-me

# ---- OpenRouter ----
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TEMPERATURE=0.9
OPENROUTER_MAX_TOKENS=500
# Optional attribution headers sent to OpenRouter
OPENROUTER_SITE_URL=https://example.com
OPENROUTER_APP_NAME=MayaBot

# ---- Storage ----
# Relative paths are resolved from the project folder
DB_PATH=data/mayabot.db
# Messages kept per chat (older ones are deleted automatically)
MAX_HISTORY_MESSAGES=40

# ---- Behaviour ----
MAX_INPUT_CHARS=1500
REQUEST_TIMEOUT=45
MAX_RETRIES=3
TYPING_MIN_DELAY=0.8
TYPING_MAX_DELAY=2.2
RATE_LIMIT_PER_MINUTE=12
# Comma-separated Telegram user IDs allowed to see global stats
ADMIN_IDS=
LOG_LEVEL=INFO